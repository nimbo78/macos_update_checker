# Конфигурация Telegram бота для отслеживания обновлений macOS

# Токен бота (получить у @BotFather)
BOT_TOKEN = "YOUR_BOT_TOKEN_HERE"

# Куда отправлять уведомления о новых релизах
# Можно указать несколько ID через запятую
# Для личного чата: укажите свой ID
# Для канала: ID начинается с -100, например: -1001234567890
NOTIFICATION_TARGETS = [
    123456789,           # Личный чат (замените на свой ID)
    # -1001234567890,    # ID канала (раскомментируйте и укажите реальный ID)
]

# Список пользователей, которые могут использовать команды бота
# Чтобы узнать свой ID, напишите боту @userinfobot
ALLOWED_USER_IDS = [
    123456789,           # Замените на свой ID
    # 987654321,         # Добавьте других пользователей
]

# Администраторы (могут использовать команду /check)
ADMIN_USER_IDS = [
    123456789,           # Замените на свой ID
]

# Интервал проверки обновлений (в секундах)
# 3600 = 1 час
# 7200 = 2 часа
# 21600 = 6 часов
CHECK_INTERVAL = 3600

# URL страниц для мониторинга разных версий macOS
# Ключ - название версии (будет отображаться в уведомлениях)
# Значение - URL страницы для парсинга
MACOS_URLS = {
    "Sequoia": "https://mrmacintosh.com/macos-sequoia-full-installer-database-download-directly-from-apple/",
    # "Sonoma": "https://mrmacintosh.com/macos-sonoma-full-installer-database-download-directly-from-apple/",
    # "Ventura": "https://mrmacintosh.com/macos-ventura-full-installer-database-download-directly-from-apple/",
}

# Для обратной совместимости (если у вас старый конфиг с MACOS_URL)
# Раскомментируйте и укажите URL, если не хотите использовать словарь
# MACOS_URL = "https://mrmacintosh.com/macos-sequoia-full-installer-database-download-directly-from-apple/"
